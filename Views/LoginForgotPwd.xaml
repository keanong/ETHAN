<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ETHAN.Views.LoginForgotPwd"
             Title="Forgot Password"
             HideSoftInputOnTapped="True"
             BackgroundColor="Transparent"
             Shell.BackgroundColor="Transparent"
             Shell.NavBarIsVisible="False"
             Padding="0"
             SafeAreaEdges="All">

    <ContentPage.Resources>
        <Style x:Key="txt" TargetType="Entry">
            <Setter Property="HeightRequest" Value="38"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"></Setter>
            <Setter Property="VerticalTextAlignment" Value="Center"></Setter>
            <Setter Property="FontSize" Value="16"></Setter>
        </Style>

        <Style TargetType="Border" x:Key="bbtxt">
            <Setter Property="StrokeShape" Value="RoundRectangle 10"></Setter>
            <Setter Property="Stroke" Value="{StaticResource Gray200}"></Setter>
            <Setter Property="BackgroundColor" Value="White"></Setter>
            <Setter Property="Padding" Value="5"></Setter>
        </Style>

    </ContentPage.Resources>

    <Grid>
        <!-- SAFE AREA CONTAINER -->
        <Grid Padding="{OnPlatform iOS='0,0,0,0', Android='0'}">
            <Border x:Name="AppContainer" VerticalOptions="Fill" HorizontalOptions="Center" BackgroundColor="{StaticResource Gray50}" Padding="0" 
                      MaximumWidthRequest="{OnIdiom Phone=99999, Tablet=500}">
                <!-- This Grid acts as a z-stack -->
                <Grid>
                    <!-- Internal layout of the card -->
                    <Grid RowDefinitions="Auto,*" BackgroundColor="Transparent">

                        <Grid HeightRequest="60" BackgroundColor="{StaticResource Gray50}" 
                          HorizontalOptions="Start" VerticalOptions="Start" ColumnDefinitions="Auto,*" Padding="0,0">

                            <ImageButton Source="arrow_left_80.png" Clicked="BackToHome" BackgroundColor="Transparent" VerticalOptions="Center"
                                                                 WidthRequest="{OnIdiom Phone=30, Tablet=40}" HeightRequest="{OnIdiom Phone=30, Tablet=40}"/>
                            <Label Grid.Column="1" Text="Return" FontSize="20" FontAttributes="Bold" 
                               TextColor="{StaticResource XDelOrange}" VerticalOptions="Center" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackToHome"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <ScrollView Grid.Row="1" BackgroundColor="{StaticResource Gray50}" Margin="10,0,10,10" HorizontalOptions="Fill">

                            <VerticalStackLayout Spacing="10">

                                <VerticalStackLayout Padding="22">
                                    <Image Source="xdelicon.png" HeightRequest="80" IsVisible="True" HorizontalOptions="Center" />
                                    <Label Text="Forgot Password" Style="{StaticResource textStyle12OrangeBold}" FontFamily="Consolas" />
                                    <Label Text="Choose Mobile or Email to send OTP to." Style="{StaticResource textStyle16BlackBold}" FontFamily="Consolas" />
                                </VerticalStackLayout>

                                <Label x:Name="lblMobileEmail" IsVisible="False" Text="asd" Margin="10,0,0,0" />

                                <VerticalStackLayout Padding="22" Spacing="5" Margin="0,-40,0,0">

                                    <Grid RowDefinitions="Auto,2" ColumnDefinitions="*,*" Margin="0,0,0,0">

                                        <Grid Grid.Column="0">
                                            <Label x:Name="LblMobile" Text="Mobile" FontSize="18" FontAttributes="Bold" 
                                            HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Padding="0,10" TextColor="{StaticResource XDelOrange}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="MobileTab_Tapped" />
                                                </Label.GestureRecognizers>
                                            </Label>

                                            <BoxView x:Name="IndicatorMobile" HeightRequest="3" VerticalOptions="End" HorizontalOptions="Fill" Color="{StaticResource XDelOrange}" IsVisible="True" />
                                        </Grid>


                                        <Grid Grid.Column="1">
                                            <Label x:Name="LblEmail" Text="Email" FontSize="18" FontAttributes="Bold" 
                                            HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Padding="0,10" TextColor="{StaticResource Gray600}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="EmailTab_Tapped" />
                                                </Label.GestureRecognizers>
                                            </Label>

                                            <BoxView x:Name="IndicatorEmail" HeightRequest="3" VerticalOptions="End" 
                                            HorizontalOptions="Fill" Color="{StaticResource XDelOrange}" IsVisible="False" />
                                        </Grid>

                                    </Grid>

                                    <Grid RowDefinitions="*,*,*" x:Name="gbMobile" ColumnSpacing="5" HorizontalOptions="Fill">

                                        <Border Grid.Column="0" Style="{StaticResource bbtxt}" HeightRequest="55" HorizontalOptions="Fill">

                                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,Auto" HorizontalOptions="Fill">
                                                <Label Grid.Row="0" Text="Registered Mobile Number" HorizontalOptions="Fill" VerticalOptions="Center" TextColor="Gray" Margin="10,0,0,0" />
                                                <Entry Grid.Row="1" x:Name="txtMobile" Text="" Style="{StaticResource txt}" MaxLength="8" ReturnType="Done" TextChanged="onMobileFieldChanged" HorizontalTextAlignment="Start" HorizontalOptions="Fill" Margin="6,0,0,0" Keyboard="Numeric"></Entry>
                                                <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" x:Name="iconVerifiedMobile" Text="&#x2714;" IsVisible="false" WidthRequest="20" 
                                                    VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" Style="{StaticResource textStyle16Green}" />
                                                <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" x:Name="iconVerifiedMobile2" Text=" " IsVisible="false" WidthRequest="20" />
                                            </Grid>

                                        </Border>

                                        <HorizontalStackLayout Grid.Row="1" x:Name="hsMobile" Margin="0,5,0,0" Spacing="5" IsVisible="False" WidthRequest="82" >
                                            <Label x:Name="lblMobile" Text="&#x2716; Invalid" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}" />
                                        </HorizontalStackLayout>

                                        <Button Grid.Row="2" Grid.Column="0" x:Name="btnMobileOTP" Clicked="RequestMobileOTP" Text="Get OTP" VerticalOptions="Center" 
                                            Style="{StaticResource bstyleOrange}" HorizontalOptions="Fill" Margin="0,10,0,5" IsVisible="False" />

                                    </Grid>

                                    <Grid x:Name="GMOTP" RowDefinitions="*,*" ColumnDefinitions="*,*" ColumnSpacing="5" HorizontalOptions="Fill" IsVisible="False">

                                        <Border Style="{StaticResource bbtxt}" HeightRequest="55" Grid.Column="0" Grid.ColumnSpan="2">

                                            <Grid RowDefinitions="*,*">
                                                <Label Grid.Row="0" Text="OTP" HorizontalOptions="Fill" VerticalOptions="Center" TextColor="Gray" Margin="10,0,0,0" />
                                                <Entry Grid.Row="1" x:Name="txtMobileOTP" Placeholder="Enter OTP sent via SMS" Text="" Style="{StaticResource txt}" ReturnType="Done" 
                                                   HorizontalTextAlignment="Start" HorizontalOptions="Fill" Margin="6,0,0,0" Keyboard="Numeric"></Entry>
                                            </Grid>

                                        </Border>

                                        <Button Grid.Row="1" Grid.Column="0" x:Name="btnMobileOTPCX" Clicked="CXMOtp_Click" Text="Cancel" VerticalOptions="Center" 
                                            Style="{StaticResource bstyleOrange}" HorizontalOptions="Fill" Margin="0,5,0,5" />

                                        <Button Grid.Row="1" Grid.Column="1" x:Name="btnMobileVerify" Clicked="IsValidMobileOTP" Text="Verify OTP" VerticalOptions="Center" 
                                            Style="{StaticResource bstyleOrange}" HorizontalOptions="Fill" Margin="0,5,0,5" />

                                    </Grid>

                                    <Grid RowDefinitions="*,*,*" x:Name="gbEmail" ColumnSpacing="5" HorizontalOptions="Fill">

                                        <Border Grid.Row="0" Style="{StaticResource bbtxt}" HeightRequest="55" HorizontalOptions="Fill">

                                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,Auto" HorizontalOptions="Fill">
                                                <Label Grid.Row="0" Text="Registered Email Address" HorizontalOptions="Fill" VerticalOptions="Center" TextColor="Gray" Margin="10,0,0,0" />
                                                <Entry Grid.Row="1" x:Name="txtEmail" Text="" Style="{StaticResource txt}" ReturnType="Done" TextChanged="onEmailFieldChanged" HorizontalTextAlignment="Start" HorizontalOptions="Fill" Margin="6,0,0,0" Keyboard="Email"></Entry>
                                                <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" x:Name="iconVerifiedEmail" Text="&#x2714;" IsVisible="false" WidthRequest="20" 
                                           VerticalTextAlignment="Center" HorizontalOptions="End" VerticalOptions="Center" Style="{StaticResource textStyle16Green}" />
                                                <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" x:Name="iconVerifiedEmail2" Text=" " IsVisible="false" WidthRequest="20" />
                                            </Grid>

                                        </Border>

                                        <HorizontalStackLayout Grid.Row="1" x:Name="hsEmail" Margin="0,5,0,0" Spacing="5" IsVisible="False" WidthRequest="82">
                                            <Label x:Name="lblEmail" Text="&#x2716; Invalid" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}" />
                                        </HorizontalStackLayout>

                                        <Button Grid.Row="2" Grid.Column="0" x:Name="btnEmailOTP" Clicked="RequestEmailOTP" Text="Get OTP" VerticalOptions="Center" 
                                            Style="{StaticResource bstyleOrange}" HorizontalOptions="Fill" Margin="0,10,0,5" IsVisible="False" />

                                    </Grid>

                                    <Grid x:Name="GEOTP" RowDefinitions="*,*" ColumnDefinitions="*,*" ColumnSpacing="5" HorizontalOptions="Fill" IsVisible="False">

                                        <Border Style="{StaticResource bbtxt}" HeightRequest="55" Grid.Column="0" Grid.ColumnSpan="2">

                                            <Grid RowDefinitions="*,*">
                                                <Label Grid.Row="0" Text="OTP" HorizontalOptions="Fill" VerticalOptions="Center" TextColor="Gray" Margin="10,0,0,0" />
                                                <Entry Grid.Row="1" x:Name="txtEmailOTP" Placeholder="Enter OTP sent via Email" Text="" Style="{StaticResource txt}" ReturnType="Done" 
                                                HorizontalTextAlignment="Start" HorizontalOptions="Fill" Margin="6,0,0,0" Keyboard="Numeric" />
                                            </Grid>

                                        </Border>

                                        <Button Grid.Row="1" Grid.Column="0" x:Name="btnEmailOTPCX" Clicked="CXEOtp_Click" Text="Cancel" VerticalOptions="Center" 
                                            Style="{StaticResource bstyleOrange}" HorizontalOptions="Fill" Margin="0,5,0,5" />

                                        <Button Grid.Row="1" Grid.Column="1" x:Name="btnEmailVerify" Clicked="IsValidEmailOTP" Text="Verify OTP" VerticalOptions="Center" 
                                            Style="{StaticResource bstyleOrange}" HorizontalOptions="Fill" Margin="0,5,0,5" />

                                    </Grid>

                                    <Label HorizontalOptions="Start" VerticalOptions="Start" Margin="10,5,0,0" 
                                    Style="{StaticResource textStyle16Black}" Text="Password must contain the following:" />

                                    <HorizontalStackLayout x:Name="hsMinEight" Margin="10,0,0,0" Spacing="5">
                                        <Label x:Name="iconMinEight" Text="&#x2716;" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}" />
                                        <Label x:Name="lblminEight" Text="Minimum 8 characters" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout x:Name="hsLowerC" Margin="10,0,0,0" Spacing="5">
                                        <Label x:Name="iconLowerC" Text="&#x2716;" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}" />
                                        <Label x:Name="lblLowerC" Text="A lowercase letter" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout x:Name="hsUpperC" Margin="10,0,0,0" Spacing="5">
                                        <Label x:Name="iconUpperC" Text="&#x2716;" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}" />
                                        <Label x:Name="lblUpperC" Text="A capital (uppercase) letter" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout x:Name="hsNum" Margin="10,0,0,0" Spacing="5">
                                        <Label x:Name="iconNum" Text="&#x2716;" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}" />
                                        <Label x:Name="lblNum" Text="A number" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout x:Name="hsPwdMatch" Margin="10,0,0,5" Spacing="5">
                                        <Label x:Name="iconPwdMatch" Text="&#x2716;" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}" />
                                        <Label x:Name="lblPwdMatch" Text="Please enter and confirm password" VerticalTextAlignment="Center" Style="{StaticResource textStyle16Red}" 
                                        HorizontalOptions="Fill" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                    </HorizontalStackLayout>

                                    <Grid RowDefinitions="*" ColumnSpacing="5" HorizontalOptions="Fill">

                                        <Border Grid.Column="0" Style="{StaticResource bbtxt}" HeightRequest="55" HorizontalOptions="Fill">

                                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,Auto">
                                                <Label Grid.Row="0" Grid.Column="0" Text="Password" HorizontalOptions="Fill" VerticalOptions="Center" TextColor="Gray" Margin="10,0,0,0" />
                                                <Entry Grid.Row="1" Grid.Column="0" x:Name="txtPwd" Text="" Style="{StaticResource txt}" ReturnType="Done" TextChanged="OnPwdFieldChanged" HorizontalTextAlignment="Start" HorizontalOptions="Fill" Margin="6,0,0,0" IsPassword="True" />
                                                <ImageButton Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" x:Name="btnTogglePwd" Source="eye_show_80.png" 
                                                              WidthRequest="{OnIdiom Phone=30, Tablet=40}" HeightRequest="{OnIdiom Phone=30, Tablet=40}" 
                                                             BackgroundColor="Transparent" VerticalOptions="Center" Margin="0,0,0,0" Clicked="OnTogglePwdClicked" />
                                            </Grid>

                                        </Border>

                                    </Grid>

                                    <Grid RowDefinitions="*" ColumnSpacing="5" HorizontalOptions="Fill" Margin="0,5,0,5">

                                        <Border Grid.Column="0" Style="{StaticResource bbtxt}" HeightRequest="55" HorizontalOptions="Fill">

                                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,Auto">
                                                <Label Grid.Row="0" Grid.Column="0" Text="Confirm Password" HorizontalOptions="Fill" VerticalOptions="Center" TextColor="Gray" Margin="10,0,0,0" />
                                                <Entry Grid.Row="1" Grid.Column="0" x:Name="txtCfmPwd" Text="" Style="{StaticResource txt}" ReturnType="Done" TextChanged="OnPwdFieldChanged" HorizontalTextAlignment="Start" HorizontalOptions="Fill" Margin="6,0,0,0" IsPassword="True" />
                                                <ImageButton Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" x:Name="btnToggleCfmPwd" Source="eye_show_80.png" 
                                                              WidthRequest="{OnIdiom Phone=30, Tablet=40}" HeightRequest="{OnIdiom Phone=30, Tablet=40}" 
                                                             BackgroundColor="Transparent" VerticalOptions="Center" Margin="0,0,0,0" Clicked="OnTogglePwdClicked" />
                                            </Grid>

                                        </Border>

                                    </Grid>

                                    <Button Margin="0,5,0,0" x:Name="btnUpdate" Clicked="btnUpdate_Click" Text="Update Password" VerticalOptions="Center" 
                                    Style="{StaticResource bstyleDisabled}" HorizontalOptions="Fill" />


                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </ScrollView>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>
</ContentPage>
